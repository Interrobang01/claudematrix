# Required: the homeserver this bot's account lives on. Use the address the bot
# can reach directly — a public hostname routes your agents through whatever
# sits in front of it.
MATRIX_HOMESERVER_URL=http://127.0.0.1:8008

# Required: an access token for the bot's account.
MATRIX_ACCESS_TOKEN=

# Optional: default working directory for Claude Code (defaults to process.cwd())
DEFAULT_CWD=/path/to/your/working/directory

# Optional: path to the claude binary (defaults to `claude` on PATH)
CLAUDE_BIN=claude

# Optional: where the /sync token is kept (defaults to ./matrix-sync.json)
MATRIX_STORAGE=

# Optional: the literal a turn can emit to decline to post anything at all.
# Defaults to NO_RESPONSE. Matched against the start of the final message.
# SILENT_TOKEN=NO_RESPONSE
